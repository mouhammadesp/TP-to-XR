      },
      {
        "order": 4,
        "action": "Observer la déviation de l'aiguille de la boussole et noter son sens",
        "safety": null
      },
      {
        "order": 5,
        "action": "Mesurer avec la règle graduée la distance à partir de laquelle l'aiguille commence à dévier",
        "safety": null
      }
