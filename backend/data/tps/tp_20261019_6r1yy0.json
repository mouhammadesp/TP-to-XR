        "action": "Poser la feuille blanche A4 sur la table, puis poser la boussole au centre de la feuille blanche",
        "safety": null
      },
      {
        "order": 2,
        "action": "Inspecter l'aimant droit et repérer ses pôles nord et sud",
        "safety": null
      },
      {
        "order": 3,
        "action": "Approcher lentement le pôle nord de l'aimant droit de la boussole",
