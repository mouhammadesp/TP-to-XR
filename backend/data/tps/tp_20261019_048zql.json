    "title": "Réaction chimique : vinaigre et bicarbonate",
    "domain": "chemical",
    "duration_minutes": 10,
    "steps": [
      {
        "order": 1,
        "action": "Poser le bécher vide sur l’établi. Poser la coupelle de bicarbonate à côté du bécher sur l’établi. Inspecter la spatule.",
        "safety": null
      },
      {
        "order": 2,
        "action": "Verser 50 mL de vinaigre blanc dans le bécher. Ajouter environ 5 g de bicarbonate de sodium dans le vinaigre à l’aide de la spatule.",
        "safety": "Porter des lunettes de protection"
      },
      {
        "order": 3,
        "action": "Observer les bulles et la mousse qui apparaissent dans le bécher. Noter ce qui se passe et identifier le dégagement d’un gaz.",
        "safety": "Ne pas fermer le bécher pendant la réaction"
      }
    ],
    "safety_warnings": [
      "Porter des lunettes de protection",
      "Utiliser uniquement du vinaigre alimentaire et du bicarbonate alimentaire",
      "Ne pas goûter le mélange",
      "Ne pas fermer le bécher pendant la réaction",
      "Prévoir un nettoyage après l’expérience"
    ]
  },
