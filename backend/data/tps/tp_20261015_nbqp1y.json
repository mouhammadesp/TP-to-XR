  "tp": {
    "title": "Étude de la germination des graines de haricot",
    "domain": "biological",
    "duration_minutes": 20,
    "steps": [
      {
        "order": 1,
        "action": "Placer une couche de coton au fond de chacun des deux gobelets.",
        "safety": null
      },
      {
        "order": 2,
        "action": "Déposer trois graines de haricot sur le coton dans chaque gobelet.",
        "safety": null
      },
      {
        "order": 3,
        "action": "Humidifier légèrement le coton du gobelet A. Laisser le coton du gobelet B sec.",
        "safety": null
      },
      {
        "order": 4,
        "action": "Étiqueter les gobelets « A : avec eau » et « B : sans eau ».",
        "safety": null
      },
      {
        "order": 5,
        "action": "Placer les deux gobelets au même endroit, à température ambiante et à la lumière indirecte.",
        "safety": null
      },
      {
        "order": 6,
        "action": "Pendant sept jours, maintenir le coton du gobelet A humide sans le noyer et observer quotidiennement les graines.",
        "safety": null
      },
      {
        "order": 7,
        "action": "Mesurer, si possible, la longueur de la racine puis de la jeune tige et noter les résultats.",
        "safety": null
      }
    ],
    "safety_warnings": [
      "Ne pas consommer les graines utilisées.",
      "Se laver les mains après la manipulation.",
      "Éviter l’excès d’eau et nettoyer le matériel après le TP."
    ]
  },
